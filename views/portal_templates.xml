<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Breadcrumbs: base portal only knows addresses; add event registration pages. -->
    <template id="portal_breadcrumbs_event_registrations" name="Portal breadcrumbs: event registrations"
        inherit_id="portal.portal_breadcrumbs" priority="36">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'event_registrations'" class="breadcrumb-item active">
                <span>Your Event Registrations</span>
            </li>
            <li t-if="page_name == 'pending_registrations'" class="breadcrumb-item active">
                <span>Pending Event Registrations</span>
            </li>
        </xpath>
    </template>

    <!-- Pending Event Registrations Portal Page -->
    <template id="portal_my_pending_registrations" name="My Pending Event Registrations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Pending Event Registrations</t>
            </t>

            <t t-if="not pending_orders">
                <div class="alert alert-info" role="alert">
                    <p class="mb-0">
                        <i class="fa fa-check-circle me-2"></i> You don't have any pending event
                        registrations. All your orders are complete! </p>
                </div>
            </t>

            <t t-if="pending_orders">
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">
                        <i class="fa fa-exclamation-triangle me-2"></i>Action Required </h4>
                    <p>
                        The following orders require attendee details to complete your event
                        registration.
                        Please click on each order to provide the necessary information.
                    </p>
                </div>

                <div class="row">
                    <t t-foreach="pending_orders" t-as="order">
                        <div class="col-lg-6 col-md-12 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-warning text-dark">
                                    <h5 class="mb-0">
                                        <i class="fa fa-shopping-cart me-2"></i> Order <t
                                            t-esc="order.name" />
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <strong>Order Date:</strong>
                                        <t t-esc="order.date_order"
                                            t-options='{"widget": "datetime"}' />
                                    </div>

                                    <div class="mb-3">
                                        <strong>Total:</strong>
                                        <span t-field="order.amount_total"
                                            t-options='{"widget": "monetary", "display_currency": order.currency_id}' />
                                    </div>

                                    <div class="mb-3">
                                        <strong>Event Tickets:</strong>
                                        <ul class="list-unstyled mb-0 mt-2">
                                            <t
                                                t-foreach="order._portal_event_order_lines()"
                                                t-as="line">
                                                <li class="mb-2">
                                                    <i class="fa fa-ticket me-2 text-primary"></i>
                                                    <span t-out="line.product_id.sudo().name" />
                                                    <span class="badge bg-primary ms-2">
                                                        <t t-esc="int(line.product_uom_qty)" />
                                                        ticket<t t-if="line.product_uom_qty > 1">s</t>
                                                    </span>
                                                    <br />
                                                    <small class="text-muted ms-4"
                                                        t-if="line.event_id">
                                                        <i class="fa fa-calendar me-1"></i>
                                                        <t t-esc="line.event_id.name" />
                                                    </small>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <a t-att-href="order.get_attendee_details_url()"
                                        class="btn btn-primary btn-block w-100">
                                        <i class="fa fa-edit me-2"></i> Complete Attendee Details </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- Add menu item to portal -->
    <template id="portal_my_home_menu_pending_registrations"
        name="Portal My Home : Pending Event Registrations"
        inherit_id="portal.portal_my_home" priority="35">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-if="portal_home_pending_event_order_count">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <h4 class="alert-heading">
                        <i class="fa fa-exclamation-triangle me-2"></i> Action Required: Complete
                        Your Event Registration </h4>
                    <p class="mb-2"> You have <strong>
                            <t t-esc="portal_home_pending_event_order_count" />
                        </strong>
                        order<t t-if="portal_home_pending_event_order_count > 1">s</t> waiting for
                        attendee details. </p>
                    <hr />
                    <p class="mb-0">
                        <a href="/my/pending-registrations" class="btn btn-warning">
                            <i class="fa fa-edit me-2"></i> Complete Attendee Details Now </a>
                    </p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"
                        aria-label="Close"></button>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Full-width urgent tile: first in the docs grid (see EventTicketStorePortal.home). -->
    <template id="portal_my_home_pending_registrations"
        name="Portal My Home : Pending Registrations"
        inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]/*[1]" position="before">
            <t t-if="portal_home_pending_event_order_count">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="config_card" t-value="True" />
                    <t t-set="show_count" t-value="True" />
                    <t t-set="bg_color" t-value="'alert alert-warning align-items-center border border-2 border-warning'" />
                    <t t-set="title">Action required: complete event attendee details</t>
                    <t t-set="url" t-value="'/my/pending-registrations'" />
                    <t t-set="text">One or more paid orders still need attendee names or information before the event.</t>
                    <t t-set="count" t-value="portal_home_pending_event_order_count" />
                </t>
            </t>
        </xpath>
    </template>

    <!-- Event Registrations portal page (all registrations) -->
    <template id="portal_my_registrations" name="My Event Registrations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Your Event Registrations</t>
            </t>

            <t t-if="not registrations">
                <div class="alert alert-info" role="alert">
                    <p class="mb-0">
                        <i class="fa fa-info-circle me-2"></i> You don't have any event
                        registrations yet. </p>
                </div>
            </t>

            <t t-if="registrations">
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Attendee</th>
                                <th>Email</th>
                                <th>Event</th>
                                <th>Ticket</th>
                                <th>Status</th>
                                <th>Order</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="registrations" t-as="reg">
                                <tr>
                                    <td>
                                        <t t-out="reg.name or '-'" />
                                    </td>
                                    <td>
                                        <t t-out="reg.email or '-'" />
                                    </td>
                                    <td>
                                        <t t-out="reg.event_id.name" />
                                    </td>
                                    <td>
                                        <t t-out="reg.event_ticket_id.name" />
                                    </td>
                                    <td>
                                        <t t-if="reg.state == 'draft'">
                                            <span class="badge bg-warning text-dark">Unconfirmed</span>
                                        </t>
                                        <t t-elif="reg.state == 'open'">
                                            <span class="badge bg-success">Registered</span>
                                        </t>
                                        <t t-elif="reg.state == 'done'">
                                            <span class="badge bg-info">Attended</span>
                                        </t>
                                        <t t-elif="reg.state == 'cancel'">
                                            <span class="badge bg-danger">Cancelled</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-secondary text-uppercase">
                                                <t t-out="reg.state" />
                                            </span>
                                        </t>
                                    </td>
                                    <td>
                                        <a t-if="reg.sale_order_id"
                                            t-att-href="reg.sale_order_id.get_portal_url()">
                                            <t t-out="reg.sale_order_id.name" />
                                        </a>
                                        <t t-if="not reg.sale_order_id">-</t>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <t t-set="can_update" t-value="can_update_map.get(reg.id, True)" />
                                            <t t-if="reg.sale_order_id and reg.sale_order_id.attendee_access_token and can_update">
                                                <a t-attf-href="/my/orders/{{ reg.sale_order_id.id }}/attendee-details/{{ reg.sale_order_id.attendee_access_token }}"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    title="Update Attendee Details">
                                                    <i class="fa fa-edit me-1"></i>Update Details </a>
                                            </t>
                                            <t t-if="reg.state in ['open', 'done']">
                                                <a
                                                    t-attf-href="/event/{{ reg.event_id.id }}/my_tickets?registration_ids=[{{ reg.id }}]&amp;tickets_hash={{ reg.event_id._get_tickets_access_hash([reg.id]) }}"
                                                    class="btn btn-sm btn-outline-primary"
                                                    target="_blank" title="Download Ticket">
                                                    <i class="fa fa-download me-1"></i>Download </a>
                                            </t>
                                            <t t-if="reg.state not in ['open', 'done'] and (not reg.sale_order_id or not reg.sale_order_id.attendee_access_token or not can_update)">
                                                <span class="text-muted">Not available</span>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <t t-if="pager">
                    <t t-call="portal.pager" />
                </t>
            </t>
        </t>
    </template>

    <!-- Same placement as Awards: first row of portal tiles (#portal_client_category), before Appointments. -->
    <template id="portal_my_home_event_registrations_entry"
        name="Portal My Home : Registrations Entry" inherit_id="portal.portal_my_home" priority="36">
        <xpath expr="//div[@id='portal_client_category']/*[1]" position="before">
            <t t-set="event_registrations_count" t-value="0" />
            <t t-set="partner" t-value="request.env.user.partner_id" />
            <t t-set="commercial_partner" t-value="partner.commercial_partner_id" />
            <t t-set="related_partners" t-value="request.env['res.partner'].search([('commercial_partner_id', '=', commercial_partner.id)])" />
            <t t-set="registrations_domain"
                t-value="[('sale_order_id.partner_id', 'in', related_partners.ids)]" />
            <t t-set="event_registrations_count"
                t-value="request.env['event.registration'].sudo().search_count(registrations_domain)" />

            <t t-call="portal.portal_docs_entry">
                <!-- Odoo 19: entry is d-none unless config_card or force_show (see portal.portal_docs_entry). -->
                <t t-set="config_card" t-value="True" />
                <t t-set="title"
                    t-value="'Your Event Registrations%s' % ((' (%s)' % event_registrations_count) if event_registrations_count else '')" />
                <t t-set="url" t-value="'/my/registrations'" />
                <t t-set="text">View and download your event tickets</t>
            </t>
        </xpath>
    </template>

</odoo>
